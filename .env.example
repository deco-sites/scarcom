# =============================================================================
# Google Business — avaliações na homepage (Scarcom)
# =============================================================================
#
# O QUE É ISSO?
#   Arquivo de EXEMPLO. Não preencha com dados reais aqui nem faça commit.
#   Valores reais: ambiente local em .env (ignorado pelo Git) ou Secrets do Deco.
#
# O QUE O CLIENTE / GESTOR DO NEGÓCIO PRECISA FAZER (resumo):
#   1) Ter uma conta Google que seja proprietária ou gestora da ficha do
#      Google Business Profile da loja (a mesma marca/endereço que aparece no Google).
#   2) No Google Cloud Console (projeto da empresa ou que autorizem criar):
#      - Ativar "Google Business Profile API" (ou fluxo equivalente indicado pela
#        documentação atual do Google para acessar reviews).
#      - Criar credenciais OAuth 2.0 (tipo "Aplicativo Web" ou "Desktop", conforme
#        o fluxo que o dev definir) e obter Client ID e Client Secret.
#   3) Completar o consentimento OAuth e obter um refresh token válido com os
#      scopes exigidos pela API (ex.: gestão do perfil da empresa / reviews — o dev
#      indica o scope exato conforme a documentação do Google no momento da implementação).
#   4) Informar ao dev o caminho do estabelecimento na API, no formato:
#        accounts/<accountId>/locations/<locationId>
#      (em geral obtém-se depois de listar contas/locações pela API ou com quem já
#       tem acesso à API.)
#   5) Enviar a URL pública da ficha (Google Maps / perfil) para o botão
#      "Ver todas as avaliações" — mesmo valor pode ir em
#      GOOGLE_BUSINESS_PUBLIC_REVIEWS_URL ou na prop no CMS.
#
# O QUE O DESENVOLVEDOR FAZ COM ISSO:
#   - Coloca as variáveis abaixo nos Secrets / Environment do projeto no Deco
#     (ou .env local só para testes).
#   - Nunca faz commit de tokens no repositório.
#
# Copie este arquivo para .env na máquina local (opcional) — ver .gitignore.
# =============================================================================

# Recurso do estabelecimento (obrigatório para a API list reviews)
# Formato: accounts/ACCOUNT_ID/locations/LOCATION_ID
GOOGLE_BUSINESS_LOCATION_NAME=

# Opção A — access token de curta duração (ex.: renovação manual ou pipeline)
GOOGLE_BUSINESS_ACCESS_TOKEN=

# Opção B — OAuth refresh (preferido em produção)
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# URL pública (Maps / ficha) para o botão "Ver todas as avaliações no Google"
GOOGLE_BUSINESS_PUBLIC_REVIEWS_URL=
